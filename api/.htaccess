Options -Indexes
RewriteEngine On
RewriteBase /api/

# Alleen de front controller is via HTTP bereikbaar. Implementatie, config en
# runtime-data mogen nooit rechtstreeks als bestand worden geserveerd.
RewriteRule ^(?:config(?:\..*)?\.php|handlers|helpers|storage)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env|.*\.(?:sqlite(?:-(?:shm|wal|journal))?|bak|log))$ - [F,L,NC]

# Stuur alle overige non-existent paden binnen /api/ naar index.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
