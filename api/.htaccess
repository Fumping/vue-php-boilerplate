Options -Indexes
RewriteEngine On
RewriteBase /api/

# Only the front controller is reachable over HTTP. Implementation files, config
# and runtime data must never be served directly as files.
RewriteRule ^(?:cli|config(?:\..*)?\.php|handlers|helpers|storage)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env|.*\.(?:sqlite(?:-(?:shm|wal|journal))?|bak|log))$ - [F,L,NC]

# Route every other non-existent path under /api/ to index.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
